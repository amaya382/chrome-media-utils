{
  "manifest_version": 3,
  "name": "Media Utils",
  "version": "0.1.0",
  "description": "Per-tab master volume, Picture-in-Picture, in-tab maximize, and Shorts as regular videos",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "declarativeNetRequestWithHostAccess", "offscreen", "scripting", "storage", "tabCapture"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-pip": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Toggle Picture-in-Picture"
    },
    "toggle-maximize": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Toggle maximize in tab"
    },
    "toggle-fullscreen": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Toggle fullscreen"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["core.js", "youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "shorts", "enabled": true, "path": "rules/shorts.json" }
    ]
  }
}
